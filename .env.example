# Copy this file to .env and adjust it. Real environment variables override values in .env.

# Database
DB_HOST=127.0.0.1
DB_NAME=yii2_labors_db
DB_USER=root
DB_PASSWORD=
# Separate database used by the test suite (never point this at real data)
TEST_DB_NAME=yii2_labors_test

# Application mode. Without these the app runs in production mode (no debug toolbar, no Gii).
YII_DEBUG=true
YII_ENV=dev

# Required outside dev mode. Generate one with: php -r "echo bin2hex(random_bytes(32));"
COOKIE_VALIDATION_KEY=

# POST /api/works: leave empty for a public endpoint, or set a secret to require "Authorization: Bearer <token>"
API_TOKEN=
# Comma-separated list of allowed CORS origins
API_CORS_ORIGINS=*
